# PayPal REST API (client-credentials app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" or "sandbox"
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Bearer token required in `Authorization: Bearer <value>` for /api/cron/*
CRON_SECRET=

# Bearer token for the (currently stubbed, 410) control-API bridge routes
BPO_API_KEY=

# Invoicer identity used when creating invoices
BUSINESS_EMAIL=

# Optional external ledger webhook the cron jobs report to (best-effort,
# non-fatal if unset -- see src/api/_cronlib.js)
BPO_LEDGER_URL=
BPO_LEDGER_WEBHOOK_TOKEN=

# Secret for the new HMAC-based capability tokens (see src/api/_lib.js and
# scripts/mint-capability.js). Required for any capability slot beyond the
# 20 legacy deposit slots recovered verbatim from production.
CAP_SECRET=
